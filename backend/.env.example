APP_NAME=ayurvedic-traceability
APP_ENV=development
# Local development default. Use PostgreSQL for production.
DATABASE_URL=sqlite:///./ayurvedic_traceability.db
POSTGRES_DB=ayurvedic_traceability
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
FABRIC_NETWORK=
FABRIC_CHANNEL=
FABRIC_CHAINCODE=
FABRIC_MSP_ID=
FABRIC_CERT_PATH=
FABRIC_KEY_PATH=
FABRIC_TLS_CERT_PATH=
STORAGE_PATH=./storage/documents
MAX_UPLOAD_SIZE=10485760
